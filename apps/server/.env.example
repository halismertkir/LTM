# LTM server configuration. Copy to .env (never commit it) or set these in your process
# manager / container. Every variable is optional; defaults are shown.

# Listen address.
LTM_HOST=0.0.0.0
LTM_PORT=8080

# Embedded database (PGlite), transient audio and the generated secret live here.
LTM_DATA_DIR=./data

# Use an external PostgreSQL (with the pgvector extension) instead of the embedded PGlite.
# DATABASE_URL=postgres://ltm:change-me@localhost:5432/ltm

# Base64 of 32 random bytes (`openssl rand -base64 32`). Encrypts stored provider API keys.
# When unset it is generated once into $LTM_DATA_DIR/secret.key (mode 0600). Changing it
# makes stored API keys unreadable (users have to enter them again).
# LTM_SECRET_KEY=

# Public origin of this server, used in pairing QR codes and for the same-origin check.
# LTM_PUBLIC_URL=https://ltm.example.org

# Allow sign-ups after the first (owner) account.
LTM_ALLOW_REGISTRATION=false

# Offer the claude_code_cli / codex_cli providers to the owner. Turn off on multi-user servers.
LTM_ALLOW_CLI_PROVIDERS=true

# Instance-default providers per role (users can override them in Settings).
# Kinds: none | anthropic | openai | openai_compatible | claude_code_cli | codex_cli
# (stt and embedding: none | openai | openai_compatible)
# LTM_LLM_KIND=openai_compatible
# LTM_LLM_MODEL=llama3.1:8b
# LTM_LLM_BASE_URL=http://localhost:11434/v1
# LTM_LLM_API_KEY=
# LTM_STT_KIND=openai_compatible
# LTM_STT_MODEL=Systran/faster-whisper-small
# LTM_STT_BASE_URL=http://localhost:8000/v1
# LTM_STT_API_KEY=
# LTM_EMBEDDING_KIND=openai_compatible
# LTM_EMBEDDING_MODEL=nomic-embed-text
# LTM_EMBEDDING_BASE_URL=http://localhost:11434/v1
# LTM_EMBEDDING_API_KEY=

# Per-request provider timeouts (ms). Local models on a CPU are slow; a timed-out request is
# aborted (which makes local servers stop generating) and retried with back-off.
LTM_LLM_TIMEOUT_MS=600000
LTM_STT_TIMEOUT_MS=300000
LTM_EMBEDDING_TIMEOUT_MS=120000

# Directory of the built web app served at "/". Default: ../web/dist when it exists.
# LTM_WEB_DIR=/srv/ltm/web

# pino log level: fatal | error | warn | info | debug | trace | silent.
LTM_LOG_LEVEL=info

# Trust X-Forwarded-* headers from a reverse proxy (client IP for rate limits, https detection).
LTM_TRUST_PROXY=false
