# Copy to .env and adjust. Never commit the real file.
# Every variable is optional; see docs/ARCHITECTURE.md → "Configuration (server)".

# Port published on the host by docker compose.
LTM_PORT=8080

# Public origin of your instance (used in pairing links / QR codes).
# LTM_PUBLIC_URL=https://ltm.example.com

# Base64 of 32 random bytes. Generated into the data volume when unset.
# Generate one with:  openssl rand -base64 32
# LTM_SECRET_KEY=

# Allow people other than the first (owner) account to sign up.
LTM_ALLOW_REGISTRATION=false

# Offer the Claude Code / Codex CLI providers to the owner (self-hosted, single owner only).
LTM_ALLOW_CLI_PROVIDERS=true

# --- External PostgreSQL (docker compose --profile postgres) ------------------
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://ltm:change-me@postgres:5432/ltm

# --- Instance-default providers (users can override in Settings) --------------
# Fully local example (docker compose --profile local-ai):
# LTM_LLM_KIND=openai_compatible
# LTM_LLM_BASE_URL=http://ollama:11434/v1
# LTM_LLM_MODEL=
# LTM_EMBEDDING_KIND=openai_compatible
# LTM_EMBEDDING_BASE_URL=http://ollama:11434/v1
# LTM_EMBEDDING_MODEL=
# LTM_STT_KIND=openai_compatible
# LTM_STT_BASE_URL=http://speaches:8000/v1
# LTM_STT_MODEL=
#
# Bring-your-own-key example:
# LTM_LLM_KIND=anthropic
# LTM_LLM_API_KEY=
